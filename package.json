{
    "name": "call4me-apify",
    "version": "1.0.0",
    "type": "module",
    "description": "call4me MCP server on Apify: AI agents place real phone calls with the user's own call4me API key.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "apify": "^3.7.0",
        "express": "^5.1.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/express": "^5.0.2",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "test": "vitest run",
        "snapshot-tools": "node scripts/snapshot-tools.mjs"
    },
    "author": "Nick Khami <me@skeptrune.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/skeptrunedev/call4me-apify"
    }
